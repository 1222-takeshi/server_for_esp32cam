# ESP32-CAM Snapshot Server — environment variables
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env

# --- Storage ---
# Directory where uploaded JPEG snapshots are stored.
# ESP32CAM_UPLOAD_DIR=/app/uploads

# Path to the SQLite database file.
# ESP32CAM_DB_PATH=/app/data/esp32cam.sqlite3

# Storage backend (only "local" is supported).
# ESP32CAM_STORAGE_BACKEND=local

# --- Server ---
# TCP port the server listens on.
# PORT=8080

# Maximum allowed request body size in bytes (default: 1 MB).
# ESP32CAM_MAX_CONTENT_LENGTH=1048576

# Maximum allowed video upload body size in bytes (default: 10 MB).
# ESP32CAM_MAX_VIDEO_CONTENT_LENGTH=10485760

# Maximum number of simultaneous WebSocket connections.
# ESP32CAM_MAX_WS_CONNECTIONS=50
# ESP32CAM_MAX_WS_PENDING_EVENTS=256

# Maximum number of simultaneous MJPEG stream viewers per camera.
# ESP32CAM_MAX_MJPEG_STREAMS=10

# Maximum number of distinct camera_ids tracked by the in-process upload
# metrics registry. Least-recently-active entries are evicted once this cap
# is exceeded. Set to 0 to disable the cap (unbounded, prior behavior).
# ESP32CAM_MAX_TRACKED_CAMERAS=500

# Log output format: "text" (default, human-readable) or "json" (structured,
# via python-json-logger).
# ESP32CAM_LOG_FORMAT=text

# --- Authentication ---
# WARNING: leaving these empty disables authentication entirely (development only).
# For production, generate values with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Set a strong random string to require X-API-Key on device endpoints
# (POST /upload, /api/status_update, /api/log_error, WS upload).
# ESP32CAM_DEVICE_API_KEY=

# When using ESP32CAM_DEVICE_API_KEY, bind the shared key to exactly one
# DEVICE_ID. Requests for other device IDs are rejected. For multiple cameras,
# use ESP32CAM_DEVICE_API_KEYS instead.
# ESP32CAM_SHARED_KEY_DEVICE_ID=

# Optional: per-device API keys as a JSON object mapping device_id -> key,
# e.g. {"cam-a": "key-a", "cam-b": "key-b"}. When set, a device's key is
# checked against its own camera_id/device_id, not just "any configured key".
# This mapping takes precedence over ESP32CAM_DEVICE_API_KEY when both are set.
# ESP32CAM_DEVICE_API_KEYS=

# Set a strong random string to require Bearer token on admin endpoints
# (DELETE/PATCH /api/cameras/<id>, GET /api/cameras/<id>/logs).
# ESP32CAM_ADMIN_TOKEN=

# --- Camera health ---
# Expected upload interval per camera in seconds. Cameras exceeding
# 2x this threshold are marked "stale"; 6x is "offline".
# ESP32CAM_CAMERA_EXPECTED_INTERVAL_SECONDS=300

# --- Storage retention ---
# Delete snapshots older than this many seconds (0 = disabled).
# Defaults to 2592000 (30 days) when unset — retention is ON by default.
# ESP32CAM_STORAGE_RETENTION_MAX_AGE_SECONDS=2592000

# Maximum total storage for uploads in bytes (0 = disabled).
# ESP32CAM_STORAGE_RETENTION_MAX_BYTES=0

# Only run the full snapshot-retention directory scan every N uploads
# instead of on every single upload (1 = scan every upload, the default,
# matching prior behavior). The scan always runs on the very first upload
# regardless of this value, so retention is still enforced right away; after
# that it is re-checked (and any backlog cleaned up) every N uploads. Raise
# this on deployments with many stored files to cut per-upload disk I/O.
# ESP32CAM_STORAGE_RETENTION_SCAN_INTERVAL_UPLOADS=1

# Run image/video retention even when no camera uploads arrive (seconds).
# Set 0 to disable the background scheduler; upload-triggered scans remain.
# The scheduler runs once per application process; keep a single Gunicorn
# worker when you want exactly one scheduler.
# ESP32CAM_RETENTION_SCHEDULER_INTERVAL_SECONDS=3600

# Delete videos older than this many seconds (0 = disabled).
# ESP32CAM_VIDEO_RETENTION_MAX_AGE_SECONDS=0

# Maximum total storage for videos in bytes (0 = disabled).
# ESP32CAM_VIDEO_RETENTION_MAX_BYTES=0

# Same as ESP32CAM_STORAGE_RETENTION_SCAN_INTERVAL_UPLOADS but for the video
# retention scan.
# ESP32CAM_VIDEO_RETENTION_SCAN_INTERVAL_UPLOADS=1

# Only recheck disk usage against ESP32CAM_STORAGE_RETENTION_MAX_BYTES every
# N uploads instead of on every single upload (1 = check every upload).
# ESP32CAM_DISK_USAGE_CHECK_INTERVAL_UPLOADS=1

# Raspberry Pi example for an 8 GB snapshot budget and 1 GB video budget:
# ESP32CAM_STORAGE_RETENTION_MAX_BYTES=8589934592
# ESP32CAM_VIDEO_RETENTION_MAX_BYTES=1073741824

# --- Inference / person detection ---
# Detector type: "disabled" (default) or "tflite_cpu".
# Requires the "ml" optional dependency group: pip install ".[ml]"
# ESP32CAM_DETECTOR=disabled

# Path to a TFLite model file (required when DETECTOR=tflite_cpu).
# ESP32CAM_MODEL_PATH=

# Path to a labels text file (one label per line, optional).
# ESP32CAM_LABELS_PATH=

# Minimum detection confidence threshold (0.0 - 1.0).
# ESP32CAM_DETECTION_THRESHOLD=0.5

# Label string used to identify a person in the model output.
# ESP32CAM_PERSON_LABEL=person

# Zero-based class index for the person class (used if PERSON_LABEL is absent).
# ESP32CAM_PERSON_CLASS_ID=0

# Number of CPU threads the TFLite interpreter uses per inference call.
# Defaults to the machine's CPU count (falling back to 4) when unset, so
# multi-core CPUs (e.g. Raspberry Pi 4) aren't left mostly idle.
# ESP32CAM_DETECTOR_NUM_THREADS=

# Inference execution mode: "async" (background thread) or "sync".
# ESP32CAM_INFERENCE_MODE=async

# Keep only snapshots that have at least one successful detection.
# Failed or skipped inference keeps the snapshot to avoid accidental data loss.
# ESP32CAM_KEEP_ONLY_DETECTED_SNAPSHOTS=false

# Optional per-camera IoU object tracking. State is process-local and resets
# safely after restart, so detections without tracking keep track_id=null.
# ESP32CAM_TRACKING_ENABLED=false
# ESP32CAM_TRACKING_IOU_THRESHOLD=0.3
# ESP32CAM_TRACKING_MAX_MISSED_FRAMES=2
# ESP32CAM_TRACKING_MAX_TRACKS_PER_CAMERA=50
# ESP32CAM_TRACKING_MAX_CAMERAS=500

# --- Upload rate limiting ---
# Flask-Limiter rate limit string for the HTTP /upload endpoint (per device API key).
# ESP32CAM_UPLOAD_RATE_LIMIT=10 per minute

# Flask-Limiter rate limit string for the video upload endpoint (per device API key).
# ESP32CAM_VIDEO_UPLOAD_RATE_LIMIT=5 per minute

# Flask-Limiter rate limit string for the POST /api/log_error endpoint (per device API key).
# ESP32CAM_LOG_ERROR_RATE_LIMIT=30 per minute

# Device log history: both limits opt in; enabling deletes existing history.
# Example for a small SD card: 10,000 rows across ALL cameras / 7 days.
# Deleted rows do not shrink physical DB/WAL files. Restart after changing.
# ESP32CAM_DEVICE_LOG_RETENTION_MAX_ROWS=10000
# ESP32CAM_DEVICE_LOG_RETENTION_MAX_AGE_SECONDS=604800

# Flask-Limiter storage URI. Use "redis://host:6379" for multi-worker deployments.
# ESP32CAM_RATELIMIT_STORAGE_URI=memory://

# Minimum seconds between consecutive WebSocket frames per connection.
# ESP32CAM_UPLOAD_WS_MIN_FRAME_INTERVAL_SECONDS=1.0

# --- JPEG validation ---
# Maximum allowed image dimension in pixels (width or height).
# ESP32CAM_UPLOAD_MAX_IMAGE_DIMENSION=4096

# --- Webhook notifications ---
# POST to this URL when a person is detected. Leave empty to disable.
# ESP32CAM_WEBHOOK_URL=

# Minimum detection score to trigger the webhook (0.0 - 1.0).
# ESP32CAM_WEBHOOK_MIN_SCORE=0.5

# Total delivery attempts, including the initial request. Set to 1 to disable retry.
# ESP32CAM_WEBHOOK_MAX_ATTEMPTS=3

# Initial retry backoff in seconds. Subsequent retries use exponential backoff.
# ESP32CAM_WEBHOOK_RETRY_BACKOFF_SECONDS=1.0

# Display-only camera LAN server origin for UI connection diagnostics.
# Do not include credentials; this does not change flashed camera settings.
ESP32CAM_DEVICE_SERVER_BASE_URL=
