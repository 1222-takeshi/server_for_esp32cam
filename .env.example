# ESP32-CAM Snapshot Server — environment variables
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env

# --- Storage ---
# Directory where uploaded JPEG snapshots are stored.
# ESP32CAM_UPLOAD_DIR=/app/uploads

# Path to the SQLite database file.
# ESP32CAM_DB_PATH=/app/data/esp32cam.sqlite3

# Storage backend (only "local" is supported).
# ESP32CAM_STORAGE_BACKEND=local

# --- Server ---
# TCP port the server listens on.
# PORT=8080

# Maximum allowed request body size in bytes (default: 1 MB).
# ESP32CAM_MAX_CONTENT_LENGTH=1048576

# Maximum number of simultaneous WebSocket connections.
# ESP32CAM_MAX_WS_CONNECTIONS=50

# --- Authentication ---
# WARNING: leaving these empty disables authentication entirely (development only).
# For production, generate values with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Set a strong random string to require X-API-Key on device endpoints
# (POST /upload, /api/status_update, /api/log_error, WS upload).
# ESP32CAM_DEVICE_API_KEY=

# Set a strong random string to require Bearer token on admin endpoints
# (DELETE/PATCH /api/cameras/<id>, GET /api/cameras/<id>/logs).
# ESP32CAM_ADMIN_TOKEN=

# --- Camera health ---
# Expected upload interval per camera in seconds. Cameras exceeding
# 2x this threshold are marked "stale"; 6x is "offline".
# ESP32CAM_CAMERA_EXPECTED_INTERVAL_SECONDS=300

# --- Storage retention ---
# Delete snapshots older than this many seconds (0 = disabled).
# ESP32CAM_STORAGE_RETENTION_MAX_AGE_SECONDS=0

# Maximum total storage for uploads in bytes (0 = disabled).
# ESP32CAM_STORAGE_RETENTION_MAX_BYTES=0

# --- Inference / person detection ---
# Detector type: "disabled" (default) or "tflite_cpu".
# Requires the "ml" optional dependency group: pip install ".[ml]"
# ESP32CAM_DETECTOR=disabled

# Path to a TFLite model file (required when DETECTOR=tflite_cpu).
# ESP32CAM_MODEL_PATH=

# Path to a labels text file (one label per line, optional).
# ESP32CAM_LABELS_PATH=

# Minimum detection confidence threshold (0.0 - 1.0).
# ESP32CAM_DETECTION_THRESHOLD=0.5

# Label string used to identify a person in the model output.
# ESP32CAM_PERSON_LABEL=person

# Zero-based class index for the person class (used if PERSON_LABEL is absent).
# ESP32CAM_PERSON_CLASS_ID=0

# Inference execution mode: "async" (background thread) or "sync".
# ESP32CAM_INFERENCE_MODE=async

# --- Upload rate limiting ---
# Flask-Limiter rate limit string for the HTTP /upload endpoint (per device API key).
# ESP32CAM_UPLOAD_RATE_LIMIT=10 per minute

# Flask-Limiter storage URI. Use "redis://host:6379" for multi-worker deployments.
# ESP32CAM_RATELIMIT_STORAGE_URI=memory://

# Minimum seconds between consecutive WebSocket frames per connection.
# ESP32CAM_UPLOAD_WS_MIN_FRAME_INTERVAL_SECONDS=1.0

# --- JPEG validation ---
# Maximum allowed image dimension in pixels (width or height).
# ESP32CAM_UPLOAD_MAX_IMAGE_DIMENSION=4096

# --- Webhook notifications ---
# POST to this URL when a person is detected. Leave empty to disable.
# ESP32CAM_WEBHOOK_URL=

# Minimum detection score to trigger the webhook (0.0 - 1.0).
# ESP32CAM_WEBHOOK_MIN_SCORE=0.5
