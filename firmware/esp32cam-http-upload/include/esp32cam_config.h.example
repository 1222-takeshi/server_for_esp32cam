#pragma once

// Copy this file to `include/esp32cam_config.h` and edit it locally.
// `include/esp32cam_config.h` is ignored by Git because it contains Wi-Fi credentials.

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Keep the first Wi-Fi test conservative. If the device cannot connect within
// this window, the firmware prints a clear failure message and keeps running so
// the serial monitor remains useful.
#define WIFI_CONNECT_TIMEOUT_MS 20000

// HTTP upload smoke test settings. Use the Mac LAN IP, not localhost/127.0.0.1.
// Example: http://192.168.1.23:8080/upload
#define UPLOAD_URL "http://YOUR_MAC_LAN_IP:8080/upload"
#define DEVICE_ID "esp32cam-01"
#define HTTP_UPLOAD_TIMEOUT_MS 10000

// NTP is used to generate the X-Captured-At header required by the Flask server.
#define NTP_SERVER "pool.ntp.org"
#define NTP_SYNC_TIMEOUT_MS 10000


// ArduinoOTA settings. Keep OTA_PASSWORD empty for no password on a private
// development LAN, or set it only in your local ignored esp32cam_config.h.
//
// These values configure the firmware running on the ESP32-CAM. PlatformIO OTA
// upload still needs the host-side destination in your shell, for example:
//   export ESP32CAM_OTA_HOST=192.168.1.50
//   export ESP32CAM_OTA_HOST=esp32cam-01.local  # if mDNS works on your LAN
//   export ESP32CAM_OTA_PORT=3232
//   export ESP32CAM_OTA_PASSWORD=
//
// Use the IP printed by the serial monitor if hostname resolution is unreliable.
#define OTA_HOSTNAME "esp32cam-01"
#define OTA_PORT 3232
#define OTA_PASSWORD ""
#define OTA_WAIT_WINDOW_MS 15000

// WebSocket upload settings. This sends JPEG binary frames to the Flask server
// endpoint `/ws/cameras/<DEVICE_ID>/upload` and the server stores each frame as
// a normal snapshot. Use the server machine's LAN IP, not localhost/127.0.0.1.
#define WS_UPLOAD_HOST "YOUR_MAC_LAN_IP"
#define WS_UPLOAD_PORT 8080
#define WS_UPLOAD_PATH "/ws/cameras/" DEVICE_ID "/upload"

// Continuous capture settings for WebSocket upload mode.
// CAPTURE_INTERVAL_MS controls the time between frame attempts.
// CAPTURE_FRAME_LIMIT = 0 means unlimited; set a positive value to capture a
// video-like burst of exactly that many frames, then keep OTA/alive loop running.
#define CAPTURE_INTERVAL_MS 5000
#define CAPTURE_FRAME_LIMIT 0
